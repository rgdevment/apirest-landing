---
import Nav from "../components/Nav.astro";
import { PRODUCTS } from "../content/products";
import { DOMAIN, LOCALES, canonical, href, type Locale } from "../site";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path?: string;
  paths?: Partial<Record<Locale, string>>;
  image?: { src: string; width: number; height: number };
  published?: string;
  here?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, locale, path = "", paths, image, published, here, schema } = Astro.props;

/// A guide keeps a different slug in each language, so the twin of a page is looked up rather
/// than assumed: without that the hreflang pair would point at a URL that does not exist.
const at = (one: Locale) => paths?.[one] ?? path;
const url = canonical(locale, at(locale));
const card = image ?? { src: locale === "es" ? "/social-es.png" : "/social.png", width: 1200, height: 630 };
const social = new URL(card.src, DOMAIN).toString();
const graphs = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    {
      LOCALES.map((one) => (
        <link rel="alternate" hreflang={one} href={canonical(one, at(one))} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={canonical("en", at("en"))} />

    <meta property="og:type" content={published ? "article" : "website"} />
    <meta property="og:site_name" content="rgdevment" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={social} />
    <meta property="og:image:width" content={String(card.width)} />
    <meta property="og:image:height" content={String(card.height)} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "es" ? "en_US" : "es_ES"} />
    {published && <meta property="article:published_time" content={published} />}
    {published && <meta property="article:author" content="Mario Hidalgo G." />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={social} />

    <meta name="theme-color" content="#f6f5f2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    {
      graphs.map((graph) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(graph)}
        />
      ))
    }
  </head>
  <body
    class="bg-paper text-[17px] leading-relaxed text-ink-soft font-sans antialiased selection:bg-ink selection:text-white sm:text-lg"
  >
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      {locale === "es" ? "Ir al contenido" : "Skip to content"}
    </a>

    <Nav locale={locale} here={here} other={at(locale === "es" ? "en" : "es")} />

    <main id="content" class="mx-auto max-w-5xl px-6 py-16 sm:px-8 sm:py-24">
      <slot />
    </main>

    <footer class="mx-auto mt-8 max-w-5xl border-t border-stone-200 px-6 py-12 sm:px-8">
      <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
        <div>
          <img src="/rgdevment.svg" alt="rgdevment" width="660" height="108" class="h-5 w-auto" />
          <p class="mt-3 max-w-xs text-sm text-stone-500">
            {
              locale === "es"
                ? "Software por convicción, no por suscripción."
                : "Software out of conviction, not subscription."
            }
          </p>
        </div>

        <nav
          class="grid grid-cols-2 gap-x-12 gap-y-2 text-sm sm:grid-cols-3"
          aria-label={locale === "es" ? "Pie" : "Footer"}
        >
          {
            PRODUCTS.map((one) => (
              <a class="text-stone-500 transition-colors hover:text-ink" href={href(locale, one.slug)}>
                {one.name}
              </a>
            ))
          }
          <a
            class="text-stone-500 transition-colors hover:text-ink"
            href={href(locale, locale === "es" ? "guias" : "guides")}
          >
            {locale === "es" ? "Guías" : "Guides"}
          </a>
          <a
            class="text-stone-500 transition-colors hover:text-ink"
            href={href(locale, locale === "es" ? "precios" : "pricing")}
          >
            {locale === "es" ? "Precios" : "Pricing"}
          </a>
          <a
            class="text-stone-500 transition-colors hover:text-ink"
            href={href(locale, locale === "es" ? "apoyar" : "support")}
          >
            {locale === "es" ? "Apoyar" : "Support"}
          </a>
          <a
            class="text-stone-500 transition-colors hover:text-ink"
            href="https://github.com/rgdevment"
            rel="noopener"
          >
            GitHub
          </a>
        </nav>
      </div>

      <p class="mt-10 text-sm text-stone-400">
        {
          locale === "es"
            ? "Mario Hidalgo G. Código abierto, cada programa con su licencia."
            : "Mario Hidalgo G. Open source, each program under its own licence."
        }
      </p>
    </footer>
  </body>
</html>
