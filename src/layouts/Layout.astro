---
import Nav from "../components/Nav.astro";
import { DOMAIN, LOCALES, canonical, href, type Locale } from "../site";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path?: string;
  paths?: Partial<Record<Locale, string>>;
  image?: string;
  here?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, locale, path = "", paths, image, here, schema } = Astro.props;

/// A guide keeps a different slug in each language, so the twin of a page is looked up rather
/// than assumed: without that the hreflang pair would point at a URL that does not exist.
const at = (one: Locale) => paths?.[one] ?? path;
const url = canonical(locale, at(locale));
const social = new URL(image ?? (locale === "es" ? "/social-es.png" : "/social.png"), DOMAIN).toString();
const graphs = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    {
      LOCALES.map((one) => (
        <link rel="alternate" hreflang={one} href={canonical(one, at(one))} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={canonical("en", at("en"))} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="rgdevment" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={social} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={social} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {
      graphs.map((graph) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(graph)}
        />
      ))
    }
  </head>
  <body
    class="bg-stone-50 text-[17px] leading-relaxed text-stone-800 font-sans antialiased selection:bg-stone-900 selection:text-white sm:text-lg"
  >
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-violet-600 focus:px-4 focus:py-2"
    >
      {locale === "es" ? "Ir al contenido" : "Skip to content"}
    </a>

    <Nav locale={locale} here={here} other={at(locale === "es" ? "en" : "es")} />

    <main id="content" class="mx-auto max-w-5xl px-6 py-16 sm:px-8 sm:py-24">
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl px-6 pb-16 text-stone-500 sm:px-8">
      <p>
        {
          locale === "es"
            ? "Software por convicción, no por suscripción."
            : "Software out of conviction, not subscription."
        }
      </p>
    </footer>
  </body>
</html>
