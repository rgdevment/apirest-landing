---
import Icon from "./Icon.astro";
import Layout from "../layouts/Layout.astro";
import { GUIDES, written } from "../content/guides";
import { type Product, storeUrl, words } from "../content/products";
import { DOMAIN, canonical, href, type Locale } from "../site";

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const t = words(product, locale);
const es = locale === "es";
const store = storeUrl(product);
const path = product.slug;

const guides = GUIDES.filter((one) => one.product === product.slug);

const say = {
  guides: es ? "Guías" : "Guides",
  what: es ? "Qué hace" : "What it does",
  install: es ? "Cómo se instala" : "How to install it",
  privacy: es ? "Privacidad" : "Privacy",
  faq: es ? "Preguntas" : "Questions",
  source: es ? "Código fuente" : "Source code",
  home: es ? "Inicio" : "Home",
  free: es ? "Gratis y de código abierto" : "Free and open source",
  direct: es ? "Descarga directa" : "Direct download",
  ways: es ? "Todas las formas de instalarlo" : "Every way to install it",
  copy: es ? "Copiar" : "Copy",
  getWin: es ? "Descargar para Windows" : "Download for Windows",
  getMac: es ? "Descargar para macOS" : "Download for macOS",
  other: es ? "¿Otro equipo?" : "On another machine?",
};

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: product.name,
    description: t.tagline,
    applicationCategory: "UtilitiesApplication",
    operatingSystem: product.platforms.join(", "),
    url: canonical(locale, path),
    ...(product.shot
      ? {
          screenshot: new URL(
            locale === "es" && product.shot.srcEs ? product.shot.srcEs : product.shot.src,
            DOMAIN,
          ).toString(),
        }
      : {}),
    license: product.repo + "/blob/main/LICENSE",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    author: { "@type": "Person", name: "Mario Hidalgo G." },
    softwareHelp: product.repo,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: t.faq.map((one) => ({
      "@type": "Question",
      name: one.q,
      acceptedAnswer: { "@type": "Answer", text: one.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: say.home, item: `${DOMAIN}${href(locale)}` },
      { "@type": "ListItem", position: 2, name: product.name, item: canonical(locale, path) },
    ],
  },
];
---

<Layout
  title={`${product.name} - ${t.tagline}`}
  description={t.problem}
  locale={locale}
  path={path}
  schema={schema}
>
  <nav class="mb-10 text-sm text-stone-500">
    <a class="hover:text-stone-900" href={href(locale)}>{say.home}</a>
    <span class="px-2">/</span>
    <span class="text-stone-700">{product.name}</span>
  </nav>

  <header>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{product.name}</h1>
    <p class="mt-3 text-xl text-stone-700">{t.tagline}</p>
    <p class="mt-6 text-lg leading-relaxed text-stone-600">{t.problem}</p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {
        product.platforms.map((one) => (
          <li class="inline-flex items-center gap-1.5 rounded-lg bg-stone-100 px-2.5 py-1.5 text-sm text-stone-600">
            <Icon name={one === "Windows" ? "windows" : "apple"} class="h-3.5 w-3.5" />
            {one}
          </li>
        ))
      }
      <li class="inline-flex items-center gap-1.5 rounded-lg bg-stone-100 px-2.5 py-1.5 text-sm text-stone-600">
        <Icon name="licence" class="h-3.5 w-3.5" />
        {product.licence}
      </li>
      <li class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-50 px-2.5 py-1.5 text-sm font-medium text-emerald-700">
        <Icon name="free" class="h-3.5 w-3.5" />
        {say.free}
      </li>
    </ul>

    <!-- Both links ship in the HTML; the script only decides which one is dressed as the main one,
         so a reader without scripts, and any crawler, still sees every platform. -->
    <div id="download" class="group mt-9">
      <p class="flex flex-wrap items-center gap-3">
        {
          store && (
            <a
              class="inline-flex items-center gap-2.5 rounded-xl border border-stone-300 px-6 py-3.5 font-medium transition hover:border-stone-400 hover:bg-white group-data-[os=win]:border-transparent group-data-[os=win]:bg-stone-900 group-data-[os=win]:text-white group-data-[os=win]:hover:bg-stone-700 group-data-[os=mac]:border-stone-200 group-data-[os=mac]:px-4 group-data-[os=mac]:py-2 group-data-[os=mac]:text-sm group-data-[os=mac]:text-stone-600"
              href={store}
              rel="noopener"
            >
              <Icon name="windows" class="h-4 w-4" />
              {say.getWin}
            </a>
          )
        }
        {
          product.cask && (
            <a
              class="inline-flex items-center gap-2.5 rounded-xl border border-stone-300 px-6 py-3.5 font-medium transition hover:border-stone-400 hover:bg-white group-data-[os=mac]:border-transparent group-data-[os=mac]:bg-stone-900 group-data-[os=mac]:text-white group-data-[os=mac]:hover:bg-stone-700 group-data-[os=win]:border-stone-200 group-data-[os=win]:px-4 group-data-[os=win]:py-2 group-data-[os=win]:text-sm group-data-[os=win]:text-stone-600"
              href="#install"
            >
              <Icon name="apple" class="h-4 w-4" />
              {say.getMac}
            </a>
          )
        }
      </p>
      <p class="mt-3 text-sm text-stone-500">
        <a class="underline transition hover:text-stone-900" href="#install">{say.ways}</a>
      </p>
    </div>

  </header>

  {
    product.shot && (
      <p class="mt-12">
        <img
          src={es && product.shot.srcEs ? product.shot.srcEs : product.shot.src}
          width={product.shot.width}
          height={product.shot.height}
          alt={es ? product.shot.es : product.shot.en}
          loading="lazy"
          decoding="async"
          class="w-full rounded-xl border border-stone-200"
        />
      </p>
    )
  }

  <section class="mt-14">
    <h2 class="text-2xl font-semibold">{say.what}</h2>
    <ul class="mt-5 space-y-4">
      {
        t.what.map((one) => (
          <li class="border-l-2 pl-4 text-stone-700" style={`border-color: ${product.accent}`}>
            {one}
          </li>
        ))
      }
    </ul>
  </section>

  <section id="install" class="mt-16 scroll-mt-24 sm:mt-24">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{say.install}</h2>

    <div class="mt-7 grid gap-4 sm:grid-cols-2">
      {
        store && (
          <a
            class="group flex items-start gap-4 rounded-2xl border border-stone-200 bg-white p-5 transition hover:border-stone-300 hover:shadow-sm"
            href={store}
            rel="noopener"
          >
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-stone-100 text-stone-700">
              <Icon name="windows" class="h-5 w-5" />
            </span>
            <span class="min-w-0">
              <span class="block font-semibold text-stone-900">Microsoft Store</span>
              <span class="mt-0.5 block text-sm text-stone-500">Windows</span>
            </span>
            <Icon name="arrow" class="ml-auto mt-1 h-4 w-4 shrink-0 text-stone-400 transition group-hover:translate-x-0.5" />
          </a>
        )
      }

      {
        product.cask && (
          <div class="rounded-2xl border border-stone-200 bg-white p-5">
            <div class="flex items-center gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-stone-100 text-stone-700">
                <Icon name="apple" class="h-5 w-5" />
              </span>
              <span>
                <span class="block font-semibold text-stone-900">Homebrew</span>
                <span class="mt-0.5 block text-sm text-stone-500">macOS</span>
              </span>
            </div>
            <div class="mt-4 flex items-start gap-2 rounded-xl bg-stone-900 py-3 pr-2 pl-3.5">
              <code class="flex-1 overflow-x-auto font-mono text-[13px] text-stone-100">
                <span class="block whitespace-nowrap">
                  <span class="text-stone-500 select-none">$ </span>brew tap rgdevment/tap
                </span>
                <span class="mt-1 block whitespace-nowrap">
                  <span class="text-stone-500 select-none">$ </span>brew install --cask{" "}
                  {product.cask}
                </span>
              </code>
              <button
                type="button"
                class="copy shrink-0 rounded-lg p-1.5 text-stone-400 transition hover:bg-stone-800 hover:text-white"
                data-copy={`brew tap rgdevment/tap
brew install --cask ${product.cask}`}
                aria-label={say.copy}
              >
                <Icon name="copy" class="h-4 w-4" />
              </button>
            </div>
          </div>
        )
      }

      {
        product.winget && (
          <div class="rounded-2xl border border-stone-200 bg-white p-5">
            <div class="flex items-center gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-stone-100 text-stone-700">
                <Icon name="windows" class="h-5 w-5" />
              </span>
              <span>
                <span class="block font-semibold text-stone-900">winget</span>
                <span class="mt-0.5 block text-sm text-stone-500">Windows</span>
              </span>
            </div>
            <div class="mt-4 flex items-center gap-2 rounded-xl bg-stone-900 py-2.5 pr-2 pl-3.5">
              <code class="flex-1 overflow-x-auto font-mono text-[13px] whitespace-nowrap text-stone-100">
                <span class="text-stone-500 select-none">$ </span>winget install {product.winget}
              </code>
              <button
                type="button"
                class="copy shrink-0 rounded-lg p-1.5 text-stone-400 transition hover:bg-stone-800 hover:text-white"
                data-copy={`winget install ${product.winget}`}
                aria-label={say.copy}
              >
                <Icon name="copy" class="h-4 w-4" />
              </button>
            </div>
          </div>
        )
      }

      <a
        class="group flex items-start gap-4 rounded-2xl border border-stone-200 bg-white p-5 transition hover:border-stone-300 hover:shadow-sm"
        href={`${product.repo}/releases`}
        rel="noopener"
      >
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-stone-100 text-stone-700">
          <Icon name="download" class="h-5 w-5" />
        </span>
        <span class="min-w-0">
          <span class="block font-semibold text-stone-900">GitHub Releases</span>
          <span class="mt-0.5 block text-sm text-stone-500">{say.direct}</span>
        </span>
        <Icon name="arrow" class="ml-auto mt-1 h-4 w-4 shrink-0 text-stone-400 transition group-hover:translate-x-0.5" />
      </a>
    </div>
  </section>

  <section class="mt-16 sm:mt-24">
    <div class="rounded-2xl border border-emerald-200/70 bg-emerald-50/60 p-7">
      <h2 class="flex items-center gap-2.5 text-xl font-semibold text-stone-900">
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white text-emerald-700">
          <Icon name="shield" class="h-[18px] w-[18px]" />
        </span>
        {say.privacy}
      </h2>
      <p class="mt-4 leading-relaxed text-stone-700">{t.privacy}</p>
    </div>
  </section>

  <section class="mt-16 sm:mt-24">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">{say.faq}</h2>
    <dl class="mt-7 divide-y divide-stone-200 border-t border-stone-200">
      {
        t.faq.map((one) => (
          <div class="py-6">
            <dt class="text-lg font-semibold text-stone-900">{one.q}</dt>
            <dd class="mt-2.5 leading-relaxed text-stone-600">{one.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    guides.length > 0 && (
      <section class="mt-14">
        <h2 class="text-2xl font-semibold">{say.guides}</h2>
        <ul class="mt-5 space-y-3">
          {guides.map((one) => (
            <li>
              <a
                class="block rounded-lg border border-stone-200 p-4 transition hover:border-stone-400 hover:bg-stone-100"
                href={href(locale, written(one, locale).slug)}
              >
                <span class="font-medium text-stone-900">{written(one, locale).title}</span>
                <span class="mt-1 block text-sm text-stone-500">
                  {written(one, locale).description}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-14 border-t border-stone-200 pt-8">
    <a class="text-stone-600 underline hover:text-stone-900" href={product.repo} rel="noopener">
      {say.source}
    </a>
  </section>
  <script is:inline>
    (() => {
      const box = document.getElementById("download");
      if (!box) return;
      const said = navigator.userAgentData?.platform || navigator.userAgent || "";
      const os = /mac|iphone|ipad/i.test(said) ? "mac" : /win/i.test(said) ? "win" : "";
      if (os) box.dataset.os = os;
    })();
    document.querySelectorAll(".copy").forEach((one) => {
      one.addEventListener("click", () => {
        navigator.clipboard?.writeText(one.dataset.copy || "");
        one.classList.add("text-emerald-400");
        setTimeout(() => one.classList.remove("text-emerald-400"), 1200);
      });
    });
  </script>
</Layout>
