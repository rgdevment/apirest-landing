---
import { PRODUCTS } from "../content/products";
import { href, type Locale } from "../site";

interface Props {
  locale: Locale;
  here?: string;
  other: string;
}

const { locale, here, other } = Astro.props;
const there: Locale = locale === "es" ? "en" : "es";
const es = locale === "es";

const links: [string, string, string][] = [
  ...PRODUCTS.map((p) => [p.slug, p.name, p.slug] as [string, string, string]),
  ...((es
    ? [
        ["guias", "Guías", "guides"],
        ["precios", "Precios", "pricing"],
        ["apoyar", "Apoyar", "support"],
      ]
    : [
        ["guides", "Guides", "guides"],
        ["pricing", "Pricing", "pricing"],
        ["support", "Support", "support"],
      ]) as [string, string, string][]),
];

const on = "text-ink font-medium";
const off = "text-stone-500 transition-colors hover:text-ink";
---

<header class="sticky top-0 z-40 border-b border-stone-200/70 bg-paper/85 backdrop-blur-md">
  <nav
    aria-label={es ? "Principal" : "Main"}
    class="mx-auto max-w-5xl px-6 sm:px-8"
  >
    <!-- A details element gives a menu that folds on a narrow screen without a line of JavaScript. -->
    <details class="group [&[open]_.shut]:hidden [&:not([open])_.open]:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-3 py-4 lg:cursor-default [&::-webkit-details-marker]:hidden"
      >
        <a class="flex items-center" href={href(locale)}>
          <img
            src="/rgdevment.svg"
            alt="rgdevment"
            width="660"
            height="108"
            class="h-6 w-auto lg:h-[26px]"
          />
        </a>

        <span class="ml-auto flex items-center gap-4 lg:hidden">
          <span class="text-stone-400" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shut h-6 w-6">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="open h-6 w-6">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </span>
        </span>

        <ul class="ml-auto hidden items-center gap-7 lg:flex">
          {
            links.map(([slug, label, key], at) => (
              <>
                {at === PRODUCTS.length && (
                  <li aria-hidden="true"><span class="block h-4 w-px bg-stone-300" /></li>
                )}
                <li>
                  <a
                    class={here === key ? on : off}
                    aria-current={here === key ? "page" : undefined}
                    href={href(locale, slug)}
                  >
                    {label}
                  </a>
                </li>
              </>
            ))
          }
          <li>
            <a
              class="rounded-full border border-stone-300 px-3 py-1 text-sm text-stone-600 transition-colors hover:border-stone-400 hover:bg-white hover:text-ink"
              href={href(there, other)}
              lang={there}
              hreflang={there}
            >
              {es ? "EN" : "ES"}
            </a>
          </li>
        </ul>
      </summary>

      <ul class="grid gap-1 pb-5 text-lg lg:hidden">
        {
          links.map(([slug, label, key]) => (
            <li>
              <a
                class={`block rounded-lg px-3 py-2 ${here === key ? "bg-white font-medium text-ink" : "text-stone-600"}`}
                aria-current={here === key ? "page" : undefined}
                href={href(locale, slug)}
              >
                {label}
              </a>
            </li>
          ))
        }
        <li class="mt-2 border-t border-stone-200 pt-3">
          <a
            class="block rounded-lg px-3 py-2 text-stone-600"
            href={href(there, other)}
            lang={there}
            hreflang={there}
          >
            {es ? "English" : "Español"}
          </a>
        </li>
      </ul>
    </details>
  </nav>
</header>
