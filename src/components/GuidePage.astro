---
import Layout from "../layouts/Layout.astro";
import { GUIDES, type Guide, written } from "../content/guides";
import { PRODUCTS, words } from "../content/products";
import { DOMAIN, canonical, href, type Locale } from "../site";

interface Props {
  guide: Guide;
  locale: Locale;
}

const { guide, locale } = Astro.props;
const t = written(guide, locale);
const es = locale === "es";
const product = PRODUCTS.find((one) => one.slug === guide.product)!;

const say = {
  home: es ? "Inicio" : "Home",
  guides: es ? "Guías" : "Guides",
  faq: es ? "Preguntas" : "Questions",
  more: es ? "Más sobre" : "More about",
  kin: es ? "Sigue por aquí" : "Carry on with",
};

const paths = { en: guide.en.slug, es: guide.es.slug };

const kin = GUIDES.filter((one) => one.id !== guide.id && one.product === guide.product);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    datePublished: guide.published,
    dateModified: guide.published,
    name: t.nativeTitle,
    description: t.description,
    step: t.nativeSteps.map((one, at) => ({
      "@type": "HowToStep",
      position: at + 1,
      name: one.title,
      text: one.body,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: t.faq.map((one) => ({
      "@type": "Question",
      name: one.q,
      acceptedAnswer: { "@type": "Answer", text: one.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: say.home, item: `${DOMAIN}${href(locale)}` },
      {
        "@type": "ListItem",
        position: 2,
        name: say.guides,
        item: canonical(locale, es ? "guias" : "guides"),
      },
      { "@type": "ListItem", position: 3, name: t.title, item: canonical(locale, t.slug) },
    ],
  },
];
---

<Layout
  title={t.title}
  description={t.description}
  locale={locale}
  path={t.slug}
  paths={paths}
  here="guides"
  published={guide.published}
  schema={schema}
>
  <nav class="mb-10 text-sm text-stone-500">
    <a class="hover:text-ink" href={href(locale)}>{say.home}</a>
    <span class="px-2">/</span>
    <a class="hover:text-ink" href={href(locale, es ? "guias" : "guides")}>{say.guides}</a>
  </nav>

  <article>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{t.title}</h1>
    <p class="mt-6 text-lg leading-relaxed text-stone-600">{t.lede}</p>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold">{t.nativeTitle}</h2>
      <ol class="mt-6 space-y-6">
        {
          t.nativeSteps.map((one, at) => (
            <li class="flex gap-4">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-stone-200 text-sm text-stone-700">
                {at + 1}
              </span>
              <div>
                <h3 class="font-medium text-ink">{one.title}</h3>
                <p class="mt-1 leading-relaxed text-stone-600">{one.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold">{t.gapTitle}</h2>
      <ul class="mt-5 space-y-4">
        {t.gap.map((one) => <li class="border-l-2 border-stone-300 pl-4 text-stone-600">{one}</li>)}
      </ul>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-semibold">{t.toolTitle}</h2>
      <ul class="mt-5 space-y-4">
        {
          t.tool.map((one) => (
            <li class="border-l-2 pl-4 text-stone-700" style={`border-color: ${product.accent}`}>
              {one}
            </li>
          ))
        }
      </ul>
      <a
        class="mt-8 inline-block rounded-lg border border-stone-300 px-5 py-3 transition hover:border-stone-400 hover:bg-stone-100"
        href={href(locale, product.slug)}
      >
        {say.more} {product.name}
        <span class="mt-1 block text-sm text-stone-500">{words(product, locale).tagline}</span>
      </a>
    </section>

    {
      kin.length > 0 && (
        <section class="mt-14">
          <h2 class="text-2xl font-semibold">{say.kin}</h2>
          <ul class="mt-5 space-y-3">
            {kin.map((one) => (
              <li>
                <a
                  class="block rounded-lg border border-stone-200 p-4 transition hover:border-stone-400 hover:bg-stone-100"
                  href={href(locale, written(one, locale).slug)}
                >
                  <span class="font-medium text-ink">{written(one, locale).title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-14">
      <h2 class="text-2xl font-semibold">{say.faq}</h2>
      <div class="mt-5 space-y-6">
        {
          t.faq.map((one) => (
            <div>
              <h3 class="font-medium text-ink">{one.q}</h3>
              <p class="mt-2 leading-relaxed text-stone-600">{one.a}</p>
            </div>
          ))
        }
      </div>
    </section>
  </article>
</Layout>
