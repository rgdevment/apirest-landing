---
import { PRODUCTS } from "../content/products";

interface Props {
  class?: string;
}

const { class: klass } = Astro.props;
---

<!-- One dot per tool, in their own colours, so the mark says what the place holds. -->
<svg
  viewBox="0 0 32 32"
  class={klass}
  role="img"
  aria-label="rgdevment"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="32" height="32" rx="9" fill="#1c1917"></rect>
  {
    PRODUCTS.map((product, at) => (
      <circle cx={9.5 + at * 6.5} cy="16" r="3.1" fill={product.accent} />
    ))
  }
</svg>
