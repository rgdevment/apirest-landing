---
import Layout from "../layouts/Layout.astro";
import { GUIDES, written } from "../content/guides";
import { PRODUCTS } from "../content/products";
import { DOMAIN, canonical, href, type Locale } from "../site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === "es";
const path = es ? "guias" : "guides";

const say = es
  ? {
      title: "Guías",
      description:
        "Cómo abrir los enlaces de Teams o de Outlook en el navegador que quieras, mandar los del trabajo a un perfil concreto, y qué alternativas hay a Browserosaurus.",
      lede: "Cada guía empieza por el ajuste que la propia aplicación ya trae, porque muchas veces con eso basta y no hace falta instalar nada. Después viene lo que ese ajuste no resuelve.",
      home: "Inicio",
    }
  : {
      title: "Guides",
      description:
        "How to open Teams or Outlook links in the browser you meant, send work links to a particular profile, and what the alternatives to Browserosaurus are.",
      lede: "Each guide starts with the setting the application already carries, because that is often enough and saves you installing anything. What it does not fix comes after.",
      home: "Home",
    };

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: say.title,
    description: say.description,
    url: canonical(locale, path),
    hasPart: GUIDES.map((one) => ({
      "@type": "Article",
      headline: written(one, locale).title,
      description: written(one, locale).description,
      url: canonical(locale, written(one, locale).slug),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: say.home, item: `${DOMAIN}${href(locale)}` },
      { "@type": "ListItem", position: 2, name: say.title, item: canonical(locale, path) },
    ],
  },
];
---

<Layout
  title={say.title}
  description={say.description}
  locale={locale}
  path={path}
  paths={{ en: "guides", es: "guias" }}
  schema={schema}
>
  <nav class="mb-10 text-sm text-stone-500">
    <a class="hover:text-stone-900" href={href(locale)}>{say.home}</a>
    <span class="px-2">/</span>
    <span class="text-stone-700">{say.title}</span>
  </nav>

  <header>
    <h1 class="text-4xl font-bold tracking-tight">{say.title}</h1>
    <p class="mt-6 text-lg leading-relaxed text-stone-600">{say.lede}</p>
  </header>

  <ul class="mt-12 space-y-4">
    {
      GUIDES.map((one) => {
        const t = written(one, locale);
        const product = PRODUCTS.find((p) => p.slug === one.product)!;
        return (
          <li>
            <a
              class="block rounded-xl border border-stone-200 bg-white p-6 transition hover:border-stone-400 hover:bg-stone-100"
              href={href(locale, t.slug)}
            >
              <h2 class="text-xl font-semibold">{t.title}</h2>
              <p class="mt-2 leading-relaxed text-stone-600">{t.description}</p>
              <p class="mt-3 flex items-center gap-2 text-sm text-stone-500">
                <span
                  class="inline-block h-2 w-2 rounded-full"
                  style={`background: ${product.accent}`}
                  aria-hidden="true"
                />
                {product.name}
              </p>
            </a>
          </li>
        );
      })
    }
  </ul>
</Layout>
